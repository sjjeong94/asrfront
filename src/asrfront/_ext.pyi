"""asrfront native extension (low-level; prefer asrfront.whisper / asrfront.sensevoice).

Frontend objects are not thread-safe: use one per thread (a call on an object that another
thread is using raises RuntimeError). Compute methods release the GIL.
Inputs must be C-contiguous float32 1-D arrays; ``out`` must be a writable C-contiguous
float32 array of the exact output shape (it is never converted or copied);
``WhisperFrontend.log_mel`` also takes rows spaced apart, e.g. ``a[:, :n]``.
"""

from collections.abc import Sequence
from typing import Any, overload

import numpy as np
import numpy.typing as npt

__version__: str

_F32 = npt.NDArray[np.float32]

def kernel_isa() -> str: ...
def all_finite(audio: _F32) -> bool: ...
def _whisper_mel_filters(n_mels: int) -> _F32: ...
def _kaldi_mel_banks(n_mels: int) -> _F32: ...
def load_memory(data: npt.NDArray[np.uint8], raw: int, max_samples: int = 0) -> _F32: ...
def probe_memory(
    data: npt.NDArray[np.uint8], raw: int, max_samples: int = 0
) -> tuple[str, int, int, int, int]: ...
def _resample(x: npt.NDArray[Any], sr_in: int, sr_out: int = 16000) -> npt.NDArray[Any]: ...
def _resample_bank(sr_in: int, sr_out: int = 16000) -> npt.NDArray[np.float64]: ...

class WhisperFrontend:
    def __init__(
        self, n_mels: int = 80, pad_or_trim: bool = True, channel_last: bool = False
    ) -> None: ...
    @property
    def n_mels(self) -> int: ...
    @property
    def channel_last(self) -> bool: ...
    def out_frames(self, n_samples: int) -> int: ...
    @overload
    def log_mel(self, audio: _F32, out: None = None) -> _F32: ...
    @overload
    def log_mel(self, audio: _F32, out: _F32) -> None: ...
    @overload
    def log_mel_padded(self, audio: _F32, n_padded: int, out: None = None) -> _F32: ...
    @overload
    def log_mel_padded(self, audio: _F32, n_padded: int, out: _F32) -> None: ...
    def log_mel_many(self, audios: Sequence[_F32], outs: Sequence[_F32]) -> int: ...
    def log_mel_padded_many(
        self, audios: Sequence[_F32], n_padded: int, outs: Sequence[_F32]
    ) -> int: ...

class Gemma4Frontend:
    def __init__(self) -> None: ...
    @staticmethod
    def out_frames(n_padded: int) -> int: ...
    @staticmethod
    def valid_frames(n_samples: int) -> int: ...
    @overload
    def log_mel(self, audio: _F32, n_frames: int, out: None = None) -> _F32: ...
    @overload
    def log_mel(self, audio: _F32, n_frames: int, out: _F32) -> None: ...
    def log_mel_many(self, audios: Sequence[_F32], n_frames: int, outs: Sequence[_F32]) -> int: ...

class SenseVoiceFrontend:
    def __init__(
        self,
        n_mels: int = 80,
        lfr_m: int = 7,
        lfr_n: int = 6,
        dither: float = 0.0,
        seed: int = 0,
        cmvn_shift: _F32 | None = None,
        cmvn_scale: _F32 | None = None,
    ) -> None: ...
    @property
    def n_mels(self) -> int: ...
    @property
    def feat_dim(self) -> int: ...
    def raw_frames(self, n_samples: int) -> int: ...
    def out_frames(self, n_samples: int) -> int: ...
    @overload
    def fbank(self, audio: _F32, out: None = None) -> _F32: ...
    @overload
    def fbank(self, audio: _F32, out: _F32) -> None: ...
    def fbank_many(self, audios: Sequence[_F32], outs: Sequence[_F32]) -> int: ...
    @overload
    def fbank_raw(self, audio: _F32, out: None = None) -> _F32: ...
    @overload
    def fbank_raw(self, audio: _F32, out: _F32) -> None: ...

class SenseVoiceStream:
    def __init__(
        self,
        n_mels: int = 80,
        lfr_m: int = 7,
        lfr_n: int = 6,
        dither: float = 0.0,
        seed: int = 0,
        cmvn_shift: _F32 | None = None,
        cmvn_scale: _F32 | None = None,
    ) -> None: ...
    @property
    def feat_dim(self) -> int: ...
    def push(self, audio: _F32) -> _F32: ...
    def finish(self) -> _F32: ...
    def reset(self) -> None: ...
